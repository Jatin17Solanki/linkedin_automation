# GCP VM Production Environment
# Copy this to .env and fill in real values: cp .env.example .env

# VM external IP (auto-detected by setup.sh, but you can set manually)
VM_IP=

# n8n basic auth (protects the n8n web UI)
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Gemini API key (free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Workflow configuration (replace CONFIGURE_ME placeholders after importing) ---

# Telegram chat ID for job notifications
TELEGRAM_CHAT_ID=

# --- Location & filter tuning (optional — defaults to Bengaluru, 4 yrs max exp) ---

# LinkedIn geoId — broad country/region scope. Default: 102713980 (India)
LOCATION_GEO_ID=

# LinkedIn f_PP place ID(s) — comma-separated for multi-city (OR match), e.g.
# "105214831,90009551" for Bengaluru + Mumbai. Default: 105214831 (Bengaluru)
LOCATION_F_PP=

# City name substrings used to validate each job's parsed location, comma-separated.
# Keep in sync with LOCATION_F_PP. Default: bengaluru,bangalore,karnataka
LOCATION_CITY_NAMES=

# Skip roles requiring more than this many years of experience. Default: 4
MAX_EXPERIENCE_YEARS=

# Google Sheet document ID (the long ID from the sheet URL)
GOOGLE_SHEET_ID=

# Email address for Gmail notifications (company search workflow)
NOTIFY_EMAIL=

# MCP webhook URL (e.g., https://<your-vm-ip>.nip.io/webhook/parse-job)
MCP_WEBHOOK_URL=
