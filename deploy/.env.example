# GCP VM Production Environment
# Copy this to .env and fill in real values: cp .env.example .env
#
# setup-gcp.sh only prompts you for N8N_BASIC_AUTH_USER/PASSWORD interactively --
# every other value below is either left blank (falls back to the default
# already baked into docker-compose.prod.yml) or must be set here by hand.
# After editing this file on the VM, apply changes with:
#   cd /opt/n8n && docker compose up -d
# (recreates the container to pick up the new values -- a plain `restart`
# does NOT re-read this file).

# VM external IP (auto-detected by setup-gcp.sh, but you can set manually)
VM_IP=

# Pre-built image to pull for the n8n container. Default (in docker-compose.prod.yml)
# is ghcr.io/jatin17solanki/linkedin-automation-n8n:latest. Override this if you've
# forked the repo and publish your own image under a different GHCR namespace.
DOCKER_IMAGE=

# n8n basic auth (protects the n8n web UI). Prompted for interactively by setup-gcp.sh.
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# --- Required: no default exists anywhere. Without these, LLM matching and
# Telegram notifications don't work at all -- get them set before you expect
# the workflow to do anything useful. ---

# Gemini API key (free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Telegram chat ID for job notifications (message @userinfobot on Telegram to get yours)
TELEGRAM_CHAT_ID=

# --- Optional: all of these already have working defaults in
# docker-compose.prod.yml (Bengaluru, 4yr experience cap, no match-%
# suppression) -- leave blank to use them. Can ALSO be set live via the
# Google Sheet's Settings tab once that's set up, with no SSH/restart
# needed -- that path takes precedence over what's set here. ---

# LinkedIn geoId -- broad country/region scope. Default: 102713980 (India)
LOCATION_GEO_ID=

# LinkedIn f_PP place ID(s) -- comma-separated for multi-city (OR match), e.g.
# "105214831,90009551" for Bengaluru + Mumbai. Default: 105214831 (Bengaluru)
LOCATION_F_PP=

# City name substrings used to validate each job's parsed location, comma-separated.
# Keep in sync with LOCATION_F_PP. Default: bengaluru,bangalore,karnataka
LOCATION_CITY_NAMES=

# Reject roles whose stated range doesn't overlap [MIN,MAX] below (touching
# boundaries count as a match; open-ended "X+" roles always satisfy MAX).
# Defaults: MAX=4, MIN=0 (no floor) -- reproduces the original single-ceiling
# behavior if you never touch either.
MAX_EXPERIENCE_YEARS=
MIN_EXPERIENCE_YEARS=

# Hide jobs scoring below this % (Gemini match) from Telegram/email -- still
# logged to the Results sheet either way. Default: 0 (no suppression)
MIN_MATCH_PERCENT=

# MCP webhook URL (e.g., https://<your-vm-ip>.nip.io/webhook/parse-job) --
# only needed if you're running the mcp-server/ MCP tool against this instance.
MCP_WEBHOOK_URL=

# --- Optional: memory tuning. Defaults below are sized for a 1GB-RAM
# free-tier instance (e2-micro/t2.micro/t3.micro) -- see TROUBLESHOOTING.md's
# "VM freezes completely" entry for why these three move together. Only
# raise these if you're deploying to a VM with more RAM than that. ---

# Docker hard memory limit on the n8n container. Default: 600m
N8N_MEM_LIMIT=

# Docker memory+swap limit on the n8n container (must be >= N8N_MEM_LIMIT).
# Default: 800m
N8N_MEMSWAP_LIMIT=

# n8n's own Node.js heap cap, in MB. Default: 512
NODE_MAX_OLD_SPACE=
